<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Mode Theme Overrides -->
    <style name="Theme.BasaratTradeInvest" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/color_basarat_green</item>
        <item name="colorPrimaryVariant">@color/color_basarat_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary / Accent -->
        <item name="colorSecondary">@color/color_basarat_green</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>

        <!-- Status Bar & Navigation Bar for Dark Mode (Dark status bar with white system icons) -->
        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/color_background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
