<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/color_text_primary" />

        <TextView
            android:id="@+id/tv_top_title"
            android:textAppearance="@style/TextAppearance.Basarat.Subheading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="IPO Detail"
            android:textColor="@color/color_text_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_back"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Identity -->
            <TextView
                android:id="@+id/tv_ipo_company"
                android:textAppearance="@style/TextAppearance.Basarat.Number.Subheading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/color_text_primary"
                tools:text="Pharmarex Laboratories Limited" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ipo_symbol"
                    android:textAppearance="@style/TextAppearance.Basarat.Meta.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_stock_symbol"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/color_text_primary"
                    tools:text="PRX" />

                <TextView
                    android:id="@+id/tv_ipo_status"
                    android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_neutral"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/color_neutral"
                    tools:text="Upcoming" />

                <TextView
                    android:id="@+id/tv_ipo_shariah"
                    android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_shariah_compliant"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Shariah"
                    android:textColor="@color/color_shariah_teal"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_ipo_sector"
                android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/color_text_secondary"
                tools:text="Pharmaceuticals" />

            <!-- Pricing -->
            <TextView
                style="@style/IpoEtfSectionTitle"
                android:text="Pricing" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_clean"
                android:orientation="vertical"
                android:padding="14dp">

                <include
                    android:id="@+id/row_floor_price"
                    layout="@layout/item_detail_label_value" />

                <include
                    android:id="@+id/row_strike_price"
                    layout="@layout/item_detail_label_value" />

                <include
                    android:id="@+id/row_listing_price"
                    layout="@layout/item_detail_label_value" />

                <include
                    android:id="@+id/row_current_price"
                    layout="@layout/item_detail_label_value" />

                <include
                    android:id="@+id/row_issue_size"
                    layout="@layout/item_detail_label_value" />
            </LinearLayout>

            <!-- Performance -->
            <TextView
                android:id="@+id/title_performance"
                style="@style/IpoEtfSectionTitle"
                android:text="Performance" />

            <LinearLayout
                android:id="@+id/layout_performance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_clean"
                android:orientation="vertical"
                android:padding="14dp">

                <include
                    android:id="@+id/row_listing_gain"
                    layout="@layout/item_detail_label_value" />

                <include
                    android:id="@+id/row_current_gain"
                    layout="@layout/item_detail_label_value" />
            </LinearLayout>

            <!-- Key dates -->
            <TextView
                android:id="@+id/title_dates"
                style="@style/IpoEtfSectionTitle"
                android:text="Key Dates" />

            <LinearLayout
                android:id="@+id/layout_dates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_clean"
                android:orientation="vertical"
                android:padding="14dp">

                <include
                    android:id="@+id/row_book_building"
                    layout="@layout/item_detail_label_value" />

                <include
                    android:id="@+id/row_subscription"
                    layout="@layout/item_detail_label_value" />

                <include
                    android:id="@+id/row_listing_date"
                    layout="@layout/item_detail_label_value" />
            </LinearLayout>

            <!-- Offering -->
            <TextView
                android:id="@+id/title_offering"
                style="@style/IpoEtfSectionTitle"
                android:text="Offering" />

            <LinearLayout
                android:id="@+id/layout_offering"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_clean"
                android:orientation="vertical"
                android:padding="14dp">

                <include
                    android:id="@+id/row_lead_manager"
                    layout="@layout/item_detail_label_value" />

                <include
                    android:id="@+id/row_subscription_multiplier"
                    layout="@layout/item_detail_label_value" />
            </LinearLayout>

            <!-- About -->
            <TextView
                android:id="@+id/title_about"
                style="@style/IpoEtfSectionTitle"
                android:text="About" />

            <TextView
                android:id="@+id/tv_ipo_description"
                android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_clean"
                android:lineSpacingExtra="3dp"
                android:padding="14dp"
                android:textColor="@color/color_text_secondary"
                tools:text="Specialized oncology formulations." />

            <Button
                android:id="@+id/btn_prospectus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/color_basarat_green"
                android:text="View Prospectus"
                android:textColor="@color/white"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Skeleton -->
    <LinearLayout
        android:id="@+id/layout_skeleton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/layout_top_bar">

        <include layout="@layout/item_skeleton_card" />

        <include layout="@layout/item_skeleton_card" />

        <include layout="@layout/item_skeleton_card" />
    </LinearLayout>

    <!-- Error -->
    <LinearLayout
        android:id="@+id/layout_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_top_bar">

        <TextView
            android:id="@+id/tv_error_message"
            android:textAppearance="@style/TextAppearance.Basarat.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/color_text_secondary"
            tools:text="Unable to load IPO" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/color_basarat_green"
            android:text="Retry"
            android:textColor="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
