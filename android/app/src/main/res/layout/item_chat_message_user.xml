<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="64dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@drawable/bg_chat_bubble_user"
        android:padding="12dp"
        android:maxWidth="320dp">

        <TextView
            android:id="@+id/tvUserMessage"
            android:textAppearance="@style/TextAppearance.Basarat.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_primary"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/tvUserTimestamp"
            android:textAppearance="@style/TextAppearance.Basarat.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/color_text_tertiary"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</FrameLayout>
