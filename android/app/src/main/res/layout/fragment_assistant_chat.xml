<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_assistant_chat_backdrop">

    <!-- BASARAT identity and quick access to conversation history -->
    <LinearLayout
        android:id="@+id/layoutAssistantHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/img_1" />

        <TextView
            android:textAppearance="@style/TextAppearance.Basarat.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.24"
            android:text="BASARAT"
            android:textColor="@color/color_text_primary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/chipAiAssistant"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_assistant_header_chip"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_ai"
                app:tint="@color/color_basarat_green" />

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/title_assistant"
                android:textColor="@color/color_basarat_green"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnConversationHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/assistant_open_history"
            android:padding="9dp"
            android:src="@drawable/ic_assistant_history"
            app:tint="@color/color_text_secondary" />
    </LinearLayout>

    <!-- Welcome, loading, error, or the live conversation -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/color_basarat_green"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvErrorMessage"
                android:textAppearance="@style/TextAppearance.Basarat.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/color_negative" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/common_retry"
                app:backgroundTint="@color/color_basarat_green" />
        </LinearLayout>

        <!-- The reference welcome layout intentionally omits the suggested-prompt card. -->
        <LinearLayout
            android:id="@+id/layoutWelcome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|start"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="42dp"
            android:paddingEnd="22dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_assistant_avatar"
                    android:contentDescription="@string/assistant_bot_description"
                    android:padding="13dp"
                    android:src="@drawable/ic_assistant_bot" />

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="top|end"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_ai"
                    app:tint="@color/color_basarat_green" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvAssistantGreeting"
                android:textAppearance="@style/TextAppearance.Basarat.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/color_text_primary"
                tools:text="Hi, Abdul Rehman" />

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/assistant_welcome_subtitle"
                android:textColor="@color/color_text_secondary" />

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/assistant_welcome_description"
                android:textColor="@color/color_text_secondary" />

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="@string/assistant_disclaimer"
                android:textColor="@color/color_text_tertiary" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            tools:listitem="@layout/item_chat_message_assistant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopGenerating"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="@string/assistant_stop_generating"
            android:textColor="@color/color_negative"
            android:textSize="12sp"
            android:visibility="gone"
            app:icon="@drawable/ic_close"
            app:iconSize="14dp"
            app:iconTint="@color/color_negative"
            app:strokeColor="@color/color_negative" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegenerate"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="@string/assistant_regenerate"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            app:icon="@drawable/ic_regenerate"
            app:iconSize="16dp"
            app:iconTint="@color/color_text_secondary"
            app:strokeColor="@color/color_divider" />
    </FrameLayout>

    <!-- Compact, rounded composer matching the reference -->
    <LinearLayout
        android:id="@+id/layoutComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_assistant_composer_shell"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:minHeight="50dp"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="5dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_assistant_composer_sparkle"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_nav_ai"
            app:tint="@color/color_basarat_green" />

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/assistant_composer_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:imeOptions="actionNone"
            android:paddingStart="11dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_input_hint"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_send_button"
            android:contentDescription="@string/assistant_send_message"
            android:elevation="2dp"
            android:padding="9dp"
            android:src="@drawable/ic_send"
            app:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
