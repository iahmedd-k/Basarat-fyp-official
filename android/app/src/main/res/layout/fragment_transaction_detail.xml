<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Top Header with Back -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/color_text_primary" />

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Number.Subheading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Transaction Detail"
                android:textColor="@color/color_text_primary" />

        </LinearLayout>

        <!-- Main Transaction Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_detail_type_badge"
                        android:textAppearance="@style/TextAppearance.Basarat.Meta.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_buy"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/color_positive"
                        tools:text="BUY" />

                    <TextView
                        android:id="@+id/tv_detail_symbol"
                        android:textAppearance="@style/TextAppearance.Basarat.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/color_text_primary"
                        tools:text="OGDC" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_detail_total"
                    android:textAppearance="@style/TextAppearance.Basarat.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/color_text_primary"
                    tools:text="PKR 29,040.00" />

                <TextView
                    android:id="@+id/tv_detail_subtotal"
                    android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/color_text_secondary"
                    tools:text="Total gross trade value" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/color_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quantity"
                        android:textColor="@color/color_text_secondary" />

                    <TextView
                        android:id="@+id/tv_detail_quantity"
                        android:textAppearance="@style/TextAppearance.Basarat.Body.Small.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_text_primary"
                        tools:text="200 Shares" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Execution Price"
                        android:textColor="@color/color_text_secondary" />

                    <TextView
                        android:id="@+id/tv_detail_price"
                        android:textAppearance="@style/TextAppearance.Basarat.Body.Small.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_text_primary"
                        tools:text="PKR 145.20" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Broker / SECP Fee"
                        android:textColor="@color/color_text_secondary" />

                    <TextView
                        android:id="@+id/tv_detail_fee"
                        android:textAppearance="@style/TextAppearance.Basarat.Body.Small.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_text_primary"
                        tools:text="PKR 15.00" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Transaction Date"
                        android:textColor="@color/color_text_secondary" />

                    <TextView
                        android:id="@+id/tv_detail_date"
                        android:textAppearance="@style/TextAppearance.Basarat.Body.Small.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_text_primary"
                        tools:text="2026-09-20" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/color_divider" />

                <TextView
                    android:id="@+id/tv_detail_tx_id"
                    android:textAppearance="@style/TextAppearance.Basarat.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_tertiary"
                    tools:text="ID: tx_9a87bf23c • Created: 2026-09-20 10:30" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Edit & Delete Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_transaction"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="3"
                android:backgroundTint="@color/color_button_primary_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.02"
                android:text="Edit"
                android:textColor="@color/color_button_primary_text"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="19dp"
                app:iconTint="@color/color_button_primary_text"
                app:rippleColor="@color/color_button_primary_ripple" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_transaction"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="2"
                android:backgroundTint="@color/color_negative_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.02"
                android:text="Delete"
                android:textColor="@color/color_negative"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="19dp"
                app:iconTint="@color/color_negative"
                app:rippleColor="@color/color_button_danger_ripple" />

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/color_basarat_green"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
