<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/color_divider"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_badge_type"
            android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_buy"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/color_positive"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="BUY" />

        <TextView
            android:id="@+id/tv_tx_symbol"
            android:textAppearance="@style/TextAppearance.Basarat.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/color_text_primary"
            app:layout_constraintBottom_toBottomOf="@id/tv_badge_type"
            app:layout_constraintEnd_toStartOf="@id/tv_tx_total"
            app:layout_constraintStart_toEndOf="@id/tv_badge_type"
            app:layout_constraintTop_toTopOf="@id/tv_badge_type"
            tools:text="OGDC" />

        <TextView
            android:id="@+id/tv_tx_total"
            android:textAppearance="@style/TextAppearance.Basarat.Number.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:textColor="@color/color_text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="PKR 29,040.00" />

        <TextView
            android:id="@+id/tv_tx_details"
            android:textAppearance="@style/TextAppearance.Basarat.Number.Meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/color_text_secondary"
            app:layout_constraintEnd_toStartOf="@id/tv_tx_fee"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_badge_type"
            tools:text="200 shares @ PKR 145.20" />

        <TextView
            android:id="@+id/tv_tx_fee"
            android:textAppearance="@style/TextAppearance.Basarat.Number.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_secondary"
            app:layout_constraintBottom_toBottomOf="@id/tv_tx_details"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_tx_details"
            tools:text="Fee: PKR 15.00" />

        <TextView
            android:id="@+id/tv_tx_date"
            android:textAppearance="@style/TextAppearance.Basarat.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/color_text_tertiary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_tx_details"
            tools:text="2026-09-20" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
