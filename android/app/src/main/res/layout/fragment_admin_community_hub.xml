<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/color_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_refresh"
            app:layout_constraintStart_toEndOf="@id/iv_back"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Subheading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Community Moderation"
                android:textColor="@color/color_text_primary" />

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reports Queue &amp; Audit Log"
                android:textColor="@color/color_text_secondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh"
            android:padding="6dp"
            android:src="@drawable/ic_regenerate"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/color_text_primary" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_border" />

    <!-- Mode Tabs: Reports Queue vs Audit Log -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/color_surface"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tab_reports"
            android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Reports Queue"
            android:textColor="@color/color_brand_primary" />

        <TextView
            android:id="@+id/tab_audit_log"
            android:textAppearance="@style/TextAppearance.Basarat.Body"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Audit Log"
            android:textColor="@color/color_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_border" />

    <!-- Filter Chips for Reports Section -->
    <HorizontalScrollView
        android:id="@+id/scroll_filter_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_filter_all"
                android:textAppearance="@style/TextAppearance.Basarat.Meta.Strong"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_feature_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="All Reports"
                android:textColor="@color/color_brand_primary" />

            <TextView
                android:id="@+id/chip_filter_pending"
                android:textAppearance="@style/TextAppearance.Basarat.Meta"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_feature_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Pending"
                android:textColor="@color/color_text_secondary" />

            <TextView
                android:id="@+id/chip_filter_reviewed"
                android:textAppearance="@style/TextAppearance.Basarat.Meta"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_feature_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Reviewed"
                android:textColor="@color/color_text_secondary" />

            <TextView
                android:id="@+id/chip_filter_dismissed"
                android:textAppearance="@style/TextAppearance.Basarat.Meta"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_feature_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Dismissed"
                android:textColor="@color/color_text_secondary" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Container for Lists & States -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Reports View -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_reports"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_reports"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="6dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Audit Log View -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_audit_log"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_audit_log"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="6dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Loading State -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/color_brand_primary"
            android:visibility="gone" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_chat_assistant"
                app:tint="@color/color_text_tertiary" />

            <TextView
                android:id="@+id/tv_empty_title"
                android:textAppearance="@style/TextAppearance.Basarat.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No Reports Found"
                android:textColor="@color/color_text_primary" />

            <TextView
                android:id="@+id/tv_empty_message"
                android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="There are currently no reports in this category."
                android:textColor="@color/color_text_secondary" />
        </LinearLayout>

        <!-- Error / Access Denied State -->
        <LinearLayout
            android:id="@+id/layout_error_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_error_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_alert_bell"
                app:tint="@color/color_negative" />

            <TextView
                android:id="@+id/tv_error_title"
                android:textAppearance="@style/TextAppearance.Basarat.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Access Denied"
                android:textColor="@color/color_text_primary" />

            <TextView
                android:id="@+id/tv_error_message"
                android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Administrator or Moderator privileges are required."
                android:textColor="@color/color_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_error_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Retry"
                app:backgroundTint="@color/color_brand_primary"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
