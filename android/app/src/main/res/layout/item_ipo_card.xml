<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card_clean"
    android:foreground="?attr/selectableItemBackground"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_ipo_symbol"
        android:textAppearance="@style/TextAppearance.Basarat.Meta.Strong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_stock_symbol"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textColor="@color/color_text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="PRX" />

    <TextView
        android:id="@+id/tv_ipo_status"
        android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_neutral"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textColor="@color/color_neutral"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Upcoming" />

    <TextView
        android:id="@+id/tv_ipo_company"
        android:textAppearance="@style/TextAppearance.Basarat.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/color_text_primary"
        app:layout_constraintEnd_toStartOf="@id/tv_ipo_floor_price"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_ipo_symbol"
        tools:text="Pharmarex Laboratories Limited" />

    <TextView
        android:id="@+id/tv_ipo_sector"
        android:textAppearance="@style/TextAppearance.Basarat.Meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/color_text_secondary"
        app:layout_constraintEnd_toStartOf="@id/tv_ipo_floor_price"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_ipo_company"
        tools:text="Pharmaceuticals" />

    <TextView
        android:id="@+id/tv_ipo_floor_label"
        android:textAppearance="@style/TextAppearance.Basarat.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Floor"
        android:textColor="@color/color_text_tertiary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_ipo_company" />

    <TextView
        android:id="@+id/tv_ipo_floor_price"
        android:textAppearance="@style/TextAppearance.Basarat.Number.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/color_text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_ipo_floor_label"
        tools:text="30.00" />

    <ImageView
        android:id="@+id/iv_ipo_shariah"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="10dp"
        android:contentDescription="Shariah compliant"
        android:src="@drawable/ic_shariah_crescent"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_ipo_sector"
        app:tint="@color/color_shariah_teal"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_ipo_shariah"
        android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="Shariah"
        android:textColor="@color/color_shariah_teal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/iv_ipo_shariah"
        app:layout_constraintStart_toEndOf="@id/iv_ipo_shariah"
        app:layout_constraintTop_toTopOf="@id/iv_ipo_shariah"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_ipo_listing_date"
        android:textAppearance="@style/TextAppearance.Basarat.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/color_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_ipo_sector"
        tools:text="Listing 25 Nov 2026" />

</androidx.constraintlayout.widget.ConstraintLayout>
