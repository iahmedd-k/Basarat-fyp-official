<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/color_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title — required field, always visible -->
        <TextView
            android:id="@+id/tv_news_title"
            android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_primary"
            android:lineSpacingMultiplier="1.3"
            tools:text="OGDC Reports Record Quarterly Earnings Amid Rising Oil Prices" />

        <!-- Source · Date — shown only if either is present (nullable fields) -->
        <TextView
            android:id="@+id/tv_news_source_date"
            android:textAppearance="@style/TextAppearance.Basarat.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/color_text_secondary"
            tools:text="Dawn Business · 2026-09-20" />

        <!-- Sentiment badge + score row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Sentiment badge (nullable — GONE when no sentiment returned) -->
            <TextView
                android:id="@+id/tv_news_sentiment_badge"
                android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="POSITIVE"
                tools:background="@drawable/bg_badge_positive"
                tools:textColor="@color/color_positive" />

            <!-- Sentiment score (nullable — GONE when no score returned) -->
            <TextView
                android:id="@+id/tv_news_sentiment_score"
                android:textAppearance="@style/TextAppearance.Basarat.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/color_text_secondary"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Score: +0.72" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
