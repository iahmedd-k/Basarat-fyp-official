<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/color_text_primary" />

        <LinearLayout
            android:id="@+id/layout_titles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layout_actions"
            app:layout_constraintStart_toEndOf="@id/iv_back"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_top_title"
                android:textAppearance="@style/TextAppearance.Basarat.Subheading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shariah"
                android:textColor="@color/color_text_primary" />

            <TextView
                android:id="@+id/tv_top_subtitle"
                android:textAppearance="@style/TextAppearance.Basarat.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="All PSX stocks — tap one to screen it"
                android:textColor="@color/color_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_search"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search"
                android:padding="5dp"
                android:src="@drawable/ic_search"
                app:tint="@color/color_text_primary" />

            <ImageView
                android:id="@+id/iv_help"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Help"
                android:padding="5dp"
                android:src="@drawable/ic_help_outline"
                app:tint="@color/color_text_primary" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Search Input Bar (Expandable on Search Click) -->
    <LinearLayout
        android:id="@+id/layout_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_segmented_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
        tools:visibility="visible">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            app:tint="@color/color_text_secondary" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search PSX symbol or company..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_secondary"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/iv_search_clear"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/color_text_secondary" />
    </LinearLayout>

    <!-- PSX Filter Pills: All Stocks | KMI-30 | KMI All Share -->
    <LinearLayout
        android:id="@+id/layout_filter_pills"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/layout_search_bar">

        <!-- All Stocks -->
        <TextView
            android:id="@+id/chip_all_stocks"
            android:textAppearance="@style/TextAppearance.Basarat.Meta.Strong"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip_filter_selected"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="All Stocks"
            android:textColor="@color/color_positive" />

        <!-- KMI-30 -->
        <TextView
            android:id="@+id/chip_kmi_30"
            android:textAppearance="@style/TextAppearance.Basarat.Meta.Strong"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_filter_unselected"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="KMI-30"
            android:textColor="@color/color_text_secondary" />
    </LinearLayout>

    <!-- Table Header Row (4 Columns matching screenshot) -->
    <LinearLayout
        android:id="@+id/layout_table_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:weightSum="100"
        app:layout_constraintTop_toBottomOf="@id/layout_filter_pills">

        <!-- Symbol -->
        <TextView
            android:id="@+id/th_symbol"
            android:textAppearance="@style/TextAppearance.Basarat.Meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="38"
            android:gravity="start"
            android:text="Symbol"
            android:textColor="@color/color_text_secondary" />

        <!-- Price ⇅ -->
        <TextView
            android:id="@+id/th_price"
            android:textAppearance="@style/TextAppearance.Basarat.Meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="20"
            android:gravity="end"
            android:text="Price ⇅"
            android:textColor="@color/color_text_secondary" />

        <!-- %Chg ⇅ -->
        <TextView
            android:id="@+id/th_change"
            android:textAppearance="@style/TextAppearance.Basarat.Meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="20"
            android:gravity="end"
            android:text="%Chg ⇅"
            android:textColor="@color/color_text_secondary" />

        <!-- Purification ⇅ -->
        <TextView
            android:id="@+id/th_purification"
            android:textAppearance="@style/TextAppearance.Basarat.Meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="22"
            android:gravity="end"
            android:text="Purification ⇅"
            android:textColor="@color/color_text_secondary" />
    </LinearLayout>

    <!-- Stock List RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_shariah_stocks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_table_header"
        tools:listitem="@layout/item_shariah_stock" />

    <!-- Loading State -->
    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/color_basarat_green"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_table_header" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_table_header">

        <TextView
            android:textAppearance="@style/TextAppearance.Basarat.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No stocks match this search"
            android:textColor="@color/color_text_secondary" />
    </LinearLayout>

    <!-- Error State -->
    <LinearLayout
        android:id="@+id/layout_error_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_table_header">

        <TextView
            android:id="@+id/tv_error_message"
            android:textAppearance="@style/TextAppearance.Basarat.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unable to load stocks"
            android:textColor="@color/color_text_secondary" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/color_basarat_green"
            android:text="Retry"
            android:textColor="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
