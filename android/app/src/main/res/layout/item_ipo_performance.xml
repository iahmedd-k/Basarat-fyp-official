<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card_clean"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_perf_symbol"
        android:textAppearance="@style/TextAppearance.Basarat.Meta.Strong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_stock_symbol"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textColor="@color/color_text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="FAST" />

    <TextView
        android:id="@+id/tv_perf_company"
        android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/color_text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_perf_symbol"
        app:layout_constraintTop_toTopOf="@id/tv_perf_symbol"
        tools:text="Fast Cables Limited" />

    <TextView
        android:id="@+id/tv_perf_sector"
        android:textAppearance="@style/TextAppearance.Basarat.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/color_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_perf_symbol"
        app:layout_constraintTop_toBottomOf="@id/tv_perf_company"
        tools:text="Engineering · Listed 12 Jun 2024" />

    <View
        android:id="@+id/divider_perf"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/color_divider"
        app:layout_constraintTop_toBottomOf="@id/tv_perf_symbol" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/divider_perf">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offer"
                android:textColor="@color/color_text_tertiary" />

            <TextView
                android:id="@+id/tv_perf_offer_price"
                android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/color_text_primary"
                tools:text="24.45" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="First Day"
                android:textColor="@color/color_text_tertiary" />

            <TextView
                android:id="@+id/tv_perf_first_day"
                android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/color_text_primary"
                tools:text="+0.00%" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total"
                android:textColor="@color/color_text_tertiary" />

            <TextView
                android:id="@+id/tv_perf_total_return"
                android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/color_positive"
                tools:text="+13.70%" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
