<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface_elevated"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/color_text_primary" />

        <TextView
            android:textAppearance="@style/TextAppearance.Basarat.Subheading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Recommendation Engine Weights"
            android:textColor="@color/color_text_primary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="32dp">

                <!-- Info Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Model Weight Allocation"
                            android:textColor="@color/color_text_primary" />

                        <TextView
                            android:textAppearance="@style/TextAppearance.Basarat.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Customize how BASARAT balances GRU Deep Learning, Technical Indicators, and Financial Fundamentals when calculating overall stock recommendations."
                            android:textColor="@color/color_text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Weights Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- 1. GRU / ML Weight -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="GRU / Machine Learning"
                                android:textColor="@color/color_text_primary" />

                            <TextView
                                android:id="@+id/tv_gru_weight_val"
                                android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/color_basarat_green"
                                tools:text="33%" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/slider_gru"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:stepSize="1"
                            android:value="33"
                            android:valueFrom="0"
                            android:valueTo="100"
                            app:thumbColor="@color/color_basarat_green"
                            app:trackColorActive="@color/color_basarat_green" />

                        <!-- 2. Technical Weight -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Technical Analysis"
                                android:textColor="@color/color_text_primary" />

                            <TextView
                                android:id="@+id/tv_tech_weight_val"
                                android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/color_ai_blue"
                                tools:text="33%" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/slider_tech"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:stepSize="1"
                            android:value="33"
                            android:valueFrom="0"
                            android:valueTo="100"
                            app:thumbColor="@color/color_ai_blue"
                            app:trackColorActive="@color/color_ai_blue" />

                        <!-- 3. Fundamental Weight -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Fundamentals"
                                android:textColor="@color/color_text_primary" />

                            <TextView
                                android:id="@+id/tv_fund_weight_val"
                                android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/color_gold_accent"
                                tools:text="34%" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/slider_fund"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:stepSize="1"
                            android:value="34"
                            android:valueFrom="0"
                            android:valueTo="100"
                            app:thumbColor="@color/color_gold_accent"
                            app:trackColorActive="@color/color_gold_accent" />

                        <!-- Normalized Total Indicator -->
                        <TextView
                            android:id="@+id/tv_total_weight"
                            android:textAppearance="@style/TextAppearance.Basarat.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/color_text_secondary"
                            tools:text="Total: 100% (Normalized on submit)" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Save Action Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_weights"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/color_basarat_green"
                    android:text="Apply Engine Weights"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_defaults"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Reset to Balanced Defaults (33/33/34)"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/color_divider" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Loading View -->
        <ProgressBar
            android:id="@+id/pb_loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/color_basarat_green"
            android:visibility="gone" />

    </FrameLayout>
</LinearLayout>
