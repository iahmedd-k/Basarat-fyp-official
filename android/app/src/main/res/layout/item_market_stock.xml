<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="16dp">

    <!-- Rank Badge -->
    <TextView
        android:id="@+id/tv_stock_rank"
        android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/bg_rank_first"
        android:gravity="center"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1" />

    <!-- Symbol & Sector Column -->
    <LinearLayout
        android:id="@+id/layout_symbol_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_stock_price"
        app:layout_constraintStart_toEndOf="@id/tv_stock_rank"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_stock_symbol"
            android:textAppearance="@style/TextAppearance.Basarat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_primary"
            tools:text="ARMAH" />

        <TextView
            android:id="@+id/tv_stock_sector"
            android:textAppearance="@style/TextAppearance.Basarat.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/color_text_secondary"
            tools:text="6022 C" />
    </LinearLayout>

    <!-- Price -->
    <TextView
        android:id="@+id/tv_stock_price"
        android:textAppearance="@style/TextAppearance.Basarat.Number.Title"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/color_text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_stock_change"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="71.85" />

    <!-- % Change -->
    <TextView
        android:id="@+id/tv_stock_change"
        android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/color_positive"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="+9.95%" />

</androidx.constraintlayout.widget.ConstraintLayout>
