<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface_elevated"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/color_text_primary" />

        <TextView
            android:id="@+id/tv_title_symbol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="13sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:text="Stock Recommendation"
            android:textColor="@color/color_text_primary"
            android:textStyle="bold" />

        <!-- Stock Details Action -->
        <TextView
            android:id="@+id/btn_view_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:text="Stock Details"
            android:textColor="@color/color_basarat_green"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="32dp">

                <!-- 1. Hero Recommendation Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tv_symbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/color_text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            tools:text="OGDC" />

                        <TextView
                            android:id="@+id/tv_stock_context"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:text="United Bank Limited · Commercial Banks" />

                        <!-- Signal Badge & Composite Score -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_signal_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_positive"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="6dp"
                                android:text="BUY"
                                android:textColor="@color/color_positive"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tv_composite_score"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/color_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="Score: +0.42" />
                        </LinearLayout>

                        <!-- Confidence Bar / Indicator -->
                        <TextView
                            android:id="@+id/tv_confidence_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Signal confidence: 78%"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="13sp" />

                        <!-- Current Price -->
                        <TextView
                            android:id="@+id/tv_current_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="13sp"
                            tools:text="Current Market Price: PKR 154.60" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_decision_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/tv_decision_reason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:padding="18dp"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="13sp"
                        tools:text="BUY suppressed because model inputs are stale." />
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Signal Components — one card, rows injected by the fragment -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layout_signal_drivers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="What drives this signal"
                            android:textColor="@color/color_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layout_component_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Typical daily range (ATR-14 expressed against the last price) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_daily_range"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="6"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Typical daily range"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_daily_range"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:textColor="@color/color_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="PKR 8.5 (2.0%)" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:gravity="end"
                            android:text="Volatility guide, not a target or stop-loss"
                            android:textColor="@color/color_text_tertiary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Engine settings that produced this signal -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_profile_weights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/row_risk_profile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="18dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Risk profile"
                                    android:textColor="@color/color_text_secondary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tv_risk_profile"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/color_text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="Moderate" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/btn_change_profile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="2dp"
                                android:gravity="center_vertical"
                                android:text="Change"
                                android:textColor="@color/color_basarat_green"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:drawableEndCompat="@drawable/ic_chevron_right"
                                app:drawableTint="@color/color_basarat_green" />
                        </LinearLayout>

                        <View
                            android:id="@+id/divider_profile_weights"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="18dp"
                            android:background="@color/color_divider" />

                        <LinearLayout
                            android:id="@+id/row_signal_weights"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="18dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Signal weights"
                                    android:textColor="@color/color_text_secondary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tv_signal_weights"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/color_text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="30 / 25 / 25 / 20" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/btn_edit_weights"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="2dp"
                                android:gravity="center_vertical"
                                android:text="Edit"
                                android:textColor="@color/color_basarat_green"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:drawableEndCompat="@drawable/ic_chevron_right"
                                app:drawableTint="@color/color_basarat_green" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Target Price & Risk Levels Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_target_stop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target Price &amp; Risk Levels"
                            android:textColor="@color/color_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <!-- Target Price -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Target Price"
                                    android:textColor="@color/color_text_tertiary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tv_detail_target_price"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:autoSizeMaxTextSize="18sp"
                                    android:autoSizeMinTextSize="14sp"
                                    android:autoSizeStepGranularity="1sp"
                                    android:autoSizeTextType="uniform"
                                    android:ellipsize="end"
                                    android:fontFeatureSettings="tnum"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/color_positive"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="PKR 168.00" />

                                <TextView
                                    android:id="@+id/tv_upside_pct"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFeatureSettings="tnum"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/color_positive"
                                    android:textSize="11sp"
                                    tools:text="+8.67% upside" />
                            </LinearLayout>

                            <!-- Stop Loss -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Stop Loss"
                                    android:textColor="@color/color_text_tertiary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tv_detail_stop_loss"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:autoSizeMaxTextSize="18sp"
                                    android:autoSizeMinTextSize="14sp"
                                    android:autoSizeStepGranularity="1sp"
                                    android:autoSizeTextType="uniform"
                                    android:ellipsize="end"
                                    android:fontFeatureSettings="tnum"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/color_negative"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="PKR 148.50" />

                                <TextView
                                    android:id="@+id/tv_downside_pct"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFeatureSettings="tnum"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/color_negative"
                                    android:textSize="11sp"
                                    tools:text="-3.95% downside" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Expected Range & ATR info -->
                        <TextView
                            android:id="@+id/tv_expected_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp"
                            tools:text="Expected Range: PKR 145.00 — PKR 172.00 (ATR-14: 3.80)" />

                        <TextView
                            android:id="@+id/tv_risk_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/color_text_tertiary"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:text="Targets unavailable while recommendation inputs are stale." />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Disclaimer -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Recommendations and target/stop levels are algorithmic models for decision support and do not represent guaranteed outcomes."
                    android:textColor="@color/color_text_tertiary"
                    android:textSize="11sp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Loading State -->
        <LinearLayout
            android:id="@+id/layout_recommendation_skeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp"
            android:visibility="gone">

            <View
                android:layout_width="180dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_skeleton" />
        </LinearLayout>

        <!-- Error State -->
        <LinearLayout
            android:id="@+id/layout_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Unable to load recommendation."
                android:textColor="@color/color_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/color_basarat_green"
                android:text="Retry"
                android:textColor="@color/white"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
