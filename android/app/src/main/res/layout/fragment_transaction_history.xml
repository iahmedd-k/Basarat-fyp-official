<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <!-- Top Header with Back -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/color_text_primary" />

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Number.Subheading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Transaction History"
                android:textColor="@color/color_text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_record_trade"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:text="Trade"
                android:textColor="@color/color_text_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/color_divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_transaction"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/color_button_primary_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="+ Add"
                android:textColor="@color/color_button_primary_text"
                android:textSize="11sp"
                app:cornerRadius="8dp" />

        </LinearLayout>

        <!-- Filters: Type (ALL, BUY, SELL) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_type_all"
                android:textAppearance="@style/TextAppearance.Basarat.Meta.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tab_selected"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="ALL"
                android:textColor="@color/color_button_primary_text" />

            <TextView
                android:id="@+id/chip_type_buy"
                android:textAppearance="@style/TextAppearance.Basarat.Meta.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tab_unselected"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="BUY ONLY"
                android:textColor="@color/color_text_secondary" />

            <TextView
                android:id="@+id/chip_type_sell"
                android:textAppearance="@style/TextAppearance.Basarat.Meta.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tab_unselected"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="SELL ONLY"
                android:textColor="@color/color_text_secondary" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_total_count"
            android:textAppearance="@style/TextAppearance.Basarat.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/color_text_tertiary"
            tools:text="Showing 20 transactions" />

        <!-- Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_transactions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            tools:listitem="@layout/item_portfolio_transaction" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Transactions Found"
                android:textColor="@color/color_text_primary" />

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Record a BUY or SELL transaction to track history."
                android:textColor="@color/color_text_secondary" />

        </LinearLayout>

    </LinearLayout>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/color_basarat_green"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
