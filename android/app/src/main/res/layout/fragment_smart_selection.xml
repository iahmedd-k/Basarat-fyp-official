<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    tools:context=".feature.recommendation.smartselection.SmartSelectionFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_background"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:navigationIconTint="@color/color_text_primary"
        app:title="@string/smart_selection_title"
        app:titleTextColor="@color/color_text_primary" />

    <TextView
        android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="2dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="@string/smart_selection_subtitle"
        android:textColor="@color/color_text_secondary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layout_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progress_candidates"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:indeterminateTint="@color/color_basarat_green"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_status"
                android:textAppearance="@style/TextAppearance.Basarat.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/color_text_secondary"
                tools:text="No live smart selections are available right now." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/common_retry"
                android:visibility="gone"
                app:backgroundTint="@color/color_basarat_green" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_smart_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="4dp"
                android:text="@string/smart_selection_candidates"
                android:textColor="@color/color_text_tertiary"
                android:letterSpacing="0.08" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_stocks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_selected_symbol"
                                android:textAppearance="@style/TextAppearance.Basarat.Subheading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/color_text_primary"
                                tools:text="OGDC" />

                            <TextView
                                android:id="@+id/tv_current_price"
                                android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/color_text_secondary"
                                tools:text="Current price · PKR 519.40" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_signal_badge"
                            android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_badge_positive"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:text="BUY"
                            android:textColor="@color/color_positive" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:cardBackgroundColor="@color/color_surface"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/color_divider"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:textAppearance="@style/TextAppearance.Basarat.Meta.Strong"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="4dp"
                                android:paddingBottom="6dp"
                                android:text="@string/smart_selection_price_history"
                                android:textColor="@color/color_text_secondary" />

                            <FrameLayout
                                android:id="@+id/chart_container"
                                android:layout_width="match_parent"
                                android:layout_height="280dp"
                                android:contentDescription="@string/smart_selection_chart_description">

                                <ProgressBar
                                    android:id="@+id/progress_setup"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_gravity="center"
                                    android:indeterminateTint="@color/color_basarat_green"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tv_breakout_levels"
                                android:textAppearance="@style/TextAppearance.Basarat.Meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:textColor="@color/color_text_secondary"
                                android:visibility="gone"
                                tools:text="Breakout PKR 124.67 · Breakdown PKR 96.40" />

                            <TextView
                                android:id="@+id/tv_breakout_status"
                                android:textAppearance="@style/TextAppearance.Basarat.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:textColor="@color/color_text_tertiary"
                                android:visibility="gone"
                                tools:text="Trading 1.85% below the breakout level" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tv_setup_message"
                        android:textAppearance="@style/TextAppearance.Basarat.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/color_text_secondary"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:cardBackgroundColor="@color/color_positive_bg"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <TextView
                                    android:textAppearance="@style/TextAppearance.Basarat.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/smart_selection_target"
                                    android:textColor="@color/color_text_secondary" />

                                <TextView
                                    android:id="@+id/tv_target_price"
                                    android:textAppearance="@style/TextAppearance.Basarat.Number.Title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/color_positive"
                                    tools:text="PKR 553.00" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            app:cardBackgroundColor="@color/color_negative_bg"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <TextView
                                    android:textAppearance="@style/TextAppearance.Basarat.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/smart_selection_stop"
                                    android:textColor="@color/color_text_secondary" />

                                <TextView
                                    android:id="@+id/tv_stop_loss"
                                    android:textAppearance="@style/TextAppearance.Basarat.Number.Title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/color_negative"
                                    tools:text="PKR 494.50" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_confidence"
                        android:textAppearance="@style/TextAppearance.Basarat.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/color_text_secondary"
                        tools:text="Confidence 78%" />

                    <TextView
                        android:id="@+id/tv_summary"
                        android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/color_text_secondary"
                        tools:text="Model setup summary appears here." />

                    <TextView
                        android:textAppearance="@style/TextAppearance.Basarat.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/smart_selection_disclaimer"
                        android:textColor="@color/color_text_tertiary" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
