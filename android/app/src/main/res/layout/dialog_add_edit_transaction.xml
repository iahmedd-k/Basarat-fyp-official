<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:textAppearance="@style/TextAppearance.Basarat.Subheading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Record Transaction"
        android:textColor="@color/color_text_primary" />

    <TextView
        android:id="@+id/tv_dialog_subtitle"
        android:textAppearance="@style/TextAppearance.Basarat.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Add a BUY or SELL order to your portfolio."
        android:textColor="@color/color_text_secondary" />

    <!-- Type Toggle: BUY / SELL -->
    <LinearLayout
        android:id="@+id/layout_type_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_select_buy"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/color_positive"
            android:text="BUY"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_select_sell"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="SELL"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/color_divider" />

    </LinearLayout>

    <!-- Stock Selection Section (Verified PSX Stocks Only) -->
    <LinearLayout
        android:id="@+id/layout_stock_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <!-- Search Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_stock_search"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search PSX Stock (e.g. LUCK, OGDC, SYS)"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/color_text_tertiary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_stock_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:textColor="@color/color_text_primary"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quick Pick PSX Chips -->
        <LinearLayout
            android:id="@+id/layout_quick_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Popular PSX Stocks:"
                android:textColor="@color/color_text_tertiary" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_chips_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_luck"
                        android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_timeframe_container"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="LUCK"
                        android:textColor="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/chip_ogdc"
                        android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_timeframe_container"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="OGDC"
                        android:textColor="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/chip_sys"
                        android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_timeframe_container"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="SYS"
                        android:textColor="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/chip_hubc"
                        android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_timeframe_container"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="HUBC"
                        android:textColor="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/chip_engro"
                        android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_timeframe_container"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="ENGRO"
                        android:textColor="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/chip_mebl"
                        android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_timeframe_container"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="MEBL"
                        android:textColor="@color/color_text_primary" />

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Live Stock Suggestions Dropdown List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_stock_suggestions"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_timeframe_container"
            android:nestedScrollingEnabled="true"
            android:visibility="gone" />

        <!-- Selected Verified Stock Card (Locked State) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_selected_stock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/color_surface_elevated"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/color_positive"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_buy"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_selected_letter"
                        android:textAppearance="@style/TextAppearance.Basarat.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="L"
                        android:textColor="@color/color_positive" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_selected_symbol"
                            android:textAppearance="@style/TextAppearance.Basarat.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LUCK"
                            android:textColor="@color/color_text_primary" />

                        <TextView
                            android:id="@+id/tv_selected_sector"
                            android:textAppearance="@style/TextAppearance.Basarat.Micro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_timeframe_container"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:text="Materials"
                            android:textColor="@color/color_text_secondary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_selected_name"
                        android:textAppearance="@style/TextAppearance.Basarat.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Lucky Cement Limited"
                        android:textColor="@color/color_text_secondary" />

                    <TextView
                        android:id="@+id/tv_selected_ltp"
                        android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Market Price: PKR 912.00"
                        android:textColor="@color/color_positive" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_change_stock"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="Change"
                    android:textColor="@color/color_brand_primary"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Quantity & Price Inputs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_quantity"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:hint="Quantity (Shares)"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_quantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_price"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:hint="Price (PKR)"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Quantity Quick Chips -->
    <LinearLayout
        android:id="@+id/layout_qty_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_qty_10"
            android:textAppearance="@style/TextAppearance.Basarat.Caption"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_timeframe_container"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="+10"
            android:textColor="@color/color_text_secondary" />

        <TextView
            android:id="@+id/chip_qty_50"
            android:textAppearance="@style/TextAppearance.Basarat.Caption"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_timeframe_container"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="+50"
            android:textColor="@color/color_text_secondary" />

        <TextView
            android:id="@+id/chip_qty_100"
            android:textAppearance="@style/TextAppearance.Basarat.Caption"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_timeframe_container"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="+100"
            android:textColor="@color/color_text_secondary" />

        <TextView
            android:id="@+id/chip_qty_500"
            android:textAppearance="@style/TextAppearance.Basarat.Caption"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_timeframe_container"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="+500"
            android:textColor="@color/color_text_secondary" />

    </LinearLayout>

    <!-- Live Total Cost Summary Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_cost_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/color_surface"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Estimated Total Cost:"
                android:textColor="@color/color_text_secondary" />

            <TextView
                android:id="@+id/tv_estimated_total"
                android:textAppearance="@style/TextAppearance.Basarat.Body.Small.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PKR 0.00"
                android:textColor="@color/color_text_primary" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Fee & Date Inputs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_fee"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:hint="Fee (PKR, optional)"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_fee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="0.0" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_date"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:hint="Date (YYYY-MM-DD)"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_form_error"
        android:textAppearance="@style/TextAppearance.Basarat.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/color_negative"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layout_saving_transaction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/color_basarat_green" />

        <TextView
            android:id="@+id/tv_saving_transaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Saving transaction…"
            android:textAppearance="@style/TextAppearance.Basarat.Meta"
            android:textColor="@color/color_text_secondary" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/color_text_secondary"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/color_button_primary_bg"
            android:text="Save"
            android:textColor="@color/color_button_primary_text"
            app:cornerRadius="8dp" />

    </LinearLayout>

</LinearLayout>
