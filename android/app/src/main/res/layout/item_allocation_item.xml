<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_allocation_label"
            android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/color_text_primary"
            tools:text="Commercial Banks" />

        <TextView
            android:id="@+id/tv_allocation_percent"
            android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_basarat_green"
            tools:text="34.5%" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_allocation"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="35"
        android:progressTint="@color/color_basarat_green" />

    <TextView
        android:id="@+id/tv_allocation_value"
        android:textAppearance="@style/TextAppearance.Basarat.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/color_text_tertiary"
        tools:text="PKR 450,000.00" />

</LinearLayout>
