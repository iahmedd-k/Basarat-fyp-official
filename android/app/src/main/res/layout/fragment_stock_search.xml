<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <!-- Top Search Bar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface_elevated"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/color_text_primary" />

        <!-- Search Input Field Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Search Icon"
                android:src="@drawable/ic_search"
                app:tint="@color/color_text_secondary" />

            <EditText
                android:id="@+id/et_search_query"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search stocks by symbol or name..."
                android:imeOptions="actionSearch"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLines="1"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_input_hint"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/iv_clear_query"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/color_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Frame for States -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. Results List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:visibility="gone"
            tools:listitem="@layout/item_stock_search_result" />

        <!-- 2. Loading State -->
        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/color_basarat_green" />

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Searching PSX stocks..."
                android:textColor="@color/color_text_secondary" />
        </LinearLayout>

        <!-- 3. Idle / Start Typing State -->
        <LinearLayout
            android:id="@+id/layout_idle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search"
                app:tint="@color/color_text_tertiary" />

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Search PSX Stocks"
                android:textColor="@color/color_text_primary" />

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Type a symbol like OGDC, LUCK, MEBL or company name"
                android:textColor="@color/color_text_secondary" />
        </LinearLayout>

        <!-- 4. Empty Results State -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Stocks Found"
                android:textColor="@color/color_text_primary" />

            <TextView
                android:id="@+id/tv_empty_message"
                android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="We couldn't find any stocks matching your search."
                android:textColor="@color/color_text_secondary" />
        </LinearLayout>

        <!-- 5. Error State -->
        <LinearLayout
            android:id="@+id/layout_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_error_message"
                android:textAppearance="@style/TextAppearance.Basarat.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Unable to load search results."
                android:textColor="@color/color_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/color_basarat_green"
                android:text="Retry"
                android:textColor="@color/white"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
