<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="64dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/bg_chat_bubble_assistant"
        android:padding="12dp"
        android:maxWidth="320dp">

        <!-- AI label -->
        <TextView
            android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BASARAT AI"
            android:textColor="@color/color_ai_blue"
            android:letterSpacing="0.05"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvAssistantMessage"
            android:textAppearance="@style/TextAppearance.Basarat.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_primary"
            android:lineSpacingExtra="4dp" />

        <!-- Streaming indicator (animated dots) -->
        <TextView
            android:id="@+id/streamingIndicator"
            android:textAppearance="@style/TextAppearance.Basarat.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●●●"
            android:textColor="@color/color_ai_blue"
            android:letterSpacing="0.3"
            android:visibility="gone"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvAssistantTimestamp"
            android:textAppearance="@style/TextAppearance.Basarat.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/color_text_tertiary"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</FrameLayout>
