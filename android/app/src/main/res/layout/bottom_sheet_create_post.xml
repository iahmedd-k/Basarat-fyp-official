<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Drag Handle -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_drag_handle" />

            <!-- Header Row: Title + Close Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_title"
                    android:textAppearance="@style/TextAppearance.Basarat.Subheading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Create Community Post"
                    android:textColor="@color/color_text_primary" />

                <ImageView
                    android:id="@+id/btn_close"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/color_text_secondary" />
            </RelativeLayout>

            <!-- Tag / Post Type Selection -->
            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Body.Small.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Select Post Tag"
                android:textColor="@color/color_text_secondary" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_tag_stock"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Stock Idea"
                    android:textColor="@color/color_text_primary"
                    app:chipBackgroundColor="@color/color_surface"
                    app:chipIcon="@drawable/ic_post_stock_idea"
                    app:chipIconSize="18dp"
                    app:chipIconTint="@color/color_text_primary"
                    app:chipIconVisible="true"
                    app:chipStrokeColor="@color/color_brand_primary"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_tag_general"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General Market"
                    android:textColor="@color/color_text_primary"
                    app:chipBackgroundColor="@color/color_surface"
                    app:chipIcon="@drawable/ic_post_general_market"
                    app:chipIconSize="18dp"
                    app:chipIconTint="@color/color_text_primary"
                    app:chipIconVisible="true"
                    app:chipStrokeColor="@color/color_border"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Stock Selection Section (Shown when STOCK tag is active) -->
            <LinearLayout
                android:id="@+id/layout_stock_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    android:textAppearance="@style/TextAppearance.Basarat.Body.Small.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Stock Ticker"
                    android:textColor="@color/color_text_secondary" />

                <!-- Quick PSX Ticker Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_quick_stocks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_stock_luck"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="LUCK" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_stock_ogdc"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OGDC" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_stock_sys"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SYS" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_stock_hubc"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HUBC" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_stock_engro"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ENGRO" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_stock_mebl"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MEBL" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_stock_mcb"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MCB" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_stock_mari"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MARI" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_stock_pso"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PSO" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Custom Stock Ticker Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_stock_symbol"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Or type ticker (e.g. PPL, FFC)"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/color_brand_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_stock_symbol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:maxLength="10"
                        android:text="LUCK"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Post Content Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="What's your analysis, thesis, or question?"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/color_brand_primary"
                app:counterEnabled="true"
                app:counterMaxLength="5000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="4"
                    android:maxLines="10"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Image Upload Preview Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_image_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/iv_preview_image"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/logo_basarat" />

                    <!-- Remove Image Button -->
                    <ImageView
                        android:id="@+id/btn_remove_image"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_badge_circle"
                        android:backgroundTint="#80000000"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:src="@drawable/ic_close"
                        app:tint="@android:color/white" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Toolbar: Attach Photo Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_attach_image"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Photo / Chart"
                    android:textColor="@color/color_brand_primary"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_image"
                    app:iconTint="@color/color_brand_primary"
                    app:strokeColor="@color/color_brand_primary" />

                <TextView
                    android:id="@+id/tv_image_status"
                    android:textAppearance="@style/TextAppearance.Basarat.Meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/color_text_secondary"
                    tools:text="1 photo selected" />
            </LinearLayout>

            <!-- Error message if validation or API fails -->
            <TextView
                android:id="@+id/tv_error_message"
                android:textAppearance="@style/TextAppearance.Basarat.Body.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/color_negative"
                android:visibility="gone"
                tools:text="Please provide post content"
                tools:visibility="visible" />

            <!-- Submit Action Button -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share_post"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="@color/color_brand_primary"
                    android:text="Share Post"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textEnd"
                    app:iconTint="@android:color/white" />

                <ProgressBar
                    android:id="@+id/progress_submitting"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@android:color/white"
                    android:visibility="gone"
                    tools:visibility="gone" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
