<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_background"
        android:elevation="1dp"
        app:title="AI Assistant"
        app:titleTextColor="@color/color_text_primary"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

    <!-- Content area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Loading state -->
        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/color_basarat_green" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_nav_ai"
                android:contentDescription="AI Assistant"
                app:tint="@color/color_ai_blue"
                android:alpha="0.7" />

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Subheading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No conversations yet"
                android:textColor="@color/color_text_primary"
                android:layout_marginTop="16dp" />

            <TextView
                android:textAppearance="@style/TextAppearance.Basarat.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start a conversation with your AI investment assistant"
                android:textColor="@color/color_text_secondary"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="24dp" />

        </LinearLayout>

        <!-- Error state -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvErrorMessage"
                android:textAppearance="@style/TextAppearance.Basarat.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_negative"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retry"
                android:layout_marginTop="16dp"
                app:backgroundTint="@color/color_basarat_green" />

        </LinearLayout>

        <!-- Conversation list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvConversations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="80dp"
            android:visibility="gone"
            tools:listitem="@layout/item_conversation" />

    </FrameLayout>

    <!-- New Conversation FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewConversation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_add"
        android:contentDescription="New Conversation"
        app:backgroundTint="@color/color_basarat_green"
        app:tint="@color/white"
        app:layout_anchor="@id/rvConversations"
        app:layout_anchorGravity="bottom|end" />

</LinearLayout>
