<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:textAppearance="@style/TextAppearance.Basarat.Subheading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Record Completed Trade"
            android:textColor="@color/color_text_primary" />

        <TextView
            android:textAppearance="@style/TextAppearance.Basarat.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Atomically record a past round-trip trade (BUY + SELL) into your ledger."
            android:textColor="@color/color_text_secondary" />

        <!-- Stock Selection Section (Verified PSX Stocks Only) -->
        <LinearLayout
            android:id="@+id/layout_trade_stock_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <!-- Search Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_trade_stock_search"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search PSX Stock (e.g. LUCK, OGDC, SYS)"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/color_text_tertiary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_trade_stock_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Quick Pick PSX Chips -->
            <LinearLayout
                android:id="@+id/layout_trade_quick_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <TextView
                    android:textAppearance="@style/TextAppearance.Basarat.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Popular PSX Stocks:"
                    android:textColor="@color/color_text_tertiary" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_trade_luck"
                            android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_timeframe_container"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="LUCK"
                            android:textColor="@color/color_text_primary" />

                        <TextView
                            android:id="@+id/chip_trade_ogdc"
                            android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_timeframe_container"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="OGDC"
                            android:textColor="@color/color_text_primary" />

                        <TextView
                            android:id="@+id/chip_trade_sys"
                            android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_timeframe_container"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="SYS"
                            android:textColor="@color/color_text_primary" />

                        <TextView
                            android:id="@+id/chip_trade_hubc"
                            android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_timeframe_container"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="HUBC"
                            android:textColor="@color/color_text_primary" />

                        <TextView
                            android:id="@+id/chip_trade_engro"
                            android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_timeframe_container"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="ENGRO"
                            android:textColor="@color/color_text_primary" />

                        <TextView
                            android:id="@+id/chip_trade_mebl"
                            android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_timeframe_container"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="MEBL"
                            android:textColor="@color/color_text_primary" />

                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Live Stock Suggestions Dropdown List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_trade_stock_suggestions"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_timeframe_container"
                android:nestedScrollingEnabled="true"
                android:visibility="gone" />

            <!-- Selected Verified Stock Card (Locked State) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_trade_selected_stock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/color_surface_elevated"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/color_positive"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_badge_buy"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_trade_selected_letter"
                            android:textAppearance="@style/TextAppearance.Basarat.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="L"
                            android:textColor="@color/color_positive" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_trade_selected_symbol"
                                android:textAppearance="@style/TextAppearance.Basarat.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LUCK"
                                android:textColor="@color/color_text_primary" />

                            <TextView
                                android:id="@+id/tv_trade_selected_sector"
                                android:textAppearance="@style/TextAppearance.Basarat.Micro"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_timeframe_container"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="1dp"
                                android:text="Materials"
                                android:textColor="@color/color_text_secondary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_trade_selected_name"
                            android:textAppearance="@style/TextAppearance.Basarat.Meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Lucky Cement Limited"
                            android:textColor="@color/color_text_secondary" />

                        <TextView
                            android:id="@+id/tv_trade_selected_ltp"
                            android:textAppearance="@style/TextAppearance.Basarat.Caption.Strong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Market Price: PKR 912.00"
                            android:textColor="@color/color_positive" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_trade_change_stock"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="Change"
                        android:textColor="@color/color_brand_primary"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Traded Quantity Input -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Shares Traded"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_trade_quantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- BUY LEG SECTION -->
        <TextView
            android:textAppearance="@style/TextAppearance.Basarat.Body.Small.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="1. Buy Entry Leg"
            android:textColor="@color/color_positive" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:hint="Buy Price"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_buy_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:hint="Buy Date"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_buy_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="YYYY-MM-DD" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:hint="Buy Fee"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_buy_fee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="0.0" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- SELL LEG SECTION -->
        <TextView
            android:textAppearance="@style/TextAppearance.Basarat.Body.Small.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="2. Sell Exit Leg"
            android:textColor="@color/color_negative" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:hint="Sell Price"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_sell_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:hint="Sell Date"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_sell_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="YYYY-MM-DD" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:hint="Sell Fee"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_sell_fee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="0.0" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Result / Summary Box (visible after creation) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_trade_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_result_pnl"
                    android:textAppearance="@style/TextAppearance.Basarat.Body.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_positive"
                    tools:text="Realized P&amp;L: +PKR 12,000 (+15.2%)" />

                <TextView
                    android:id="@+id/tv_result_details"
                    android:textAppearance="@style/TextAppearance.Basarat.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/color_text_secondary"
                    tools:text="Held for 45 days • Invested: PKR 80,000 • Proceeds: PKR 92,000" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_trade_error"
            android:textAppearance="@style/TextAppearance.Basarat.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/color_negative"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_recording_trade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="@color/color_basarat_green" />

            <TextView
                android:id="@+id/tv_recording_trade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Recording completed trade…"
                android:textAppearance="@style/TextAppearance.Basarat.Meta"
                android:textColor="@color/color_text_secondary" />
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_trade"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/color_text_secondary"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit_trade"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/color_button_primary_bg"
                android:text="Record Trade"
                android:textColor="@color/color_button_primary_text"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
