<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_clean"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:textAppearance="@style/TextAppearance.Basarat.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Listed IPOs"
                        android:textColor="@color/color_text_tertiary" />

                    <TextView
                        android:id="@+id/tv_total_listed"
                        android:textAppearance="@style/TextAppearance.Basarat.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/color_text_primary"
                        tools:text="3" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:textAppearance="@style/TextAppearance.Basarat.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avg listing-day gain"
                        android:textColor="@color/color_text_tertiary" />

                    <TextView
                        android:id="@+id/tv_avg_gain"
                        android:textAppearance="@style/TextAppearance.Basarat.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/color_text_primary"
                        tools:text="+0.00%" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/title_top_performers"
                android:textAppearance="@style/TextAppearance.Basarat.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="18dp"
                android:text="Top Performers"
                android:textColor="@color/color_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_top_performers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_ipo_performance" />

            <TextView
                android:id="@+id/title_recent_listings"
                android:textAppearance="@style/TextAppearance.Basarat.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="18dp"
                android:text="Recent Listings"
                android:textColor="@color/color_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent_listings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_ipo_performance" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layout_skeleton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/item_skeleton_card" />

        <include layout="@layout/item_skeleton_card" />

        <include layout="@layout/item_skeleton_card" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:textAppearance="@style/TextAppearance.Basarat.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No IPO performance data"
            android:textColor="@color/color_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_error_message"
            android:textAppearance="@style/TextAppearance.Basarat.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/color_text_secondary"
            tools:text="Unable to load performance" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/color_basarat_green"
            android:text="Retry"
            android:textColor="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
