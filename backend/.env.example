PROJECT_NAME=Basarat
ENVIRONMENT=development
DEBUG=false

# Generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON arrays; set explicit production origins and ingress proxy IPs.
CORS_ORIGINS=[]
TRUSTED_PROXY_IPS=[]

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/basarat
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/basarat

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

MAX_FILE_SIZE_MB=10
LOCAL_TEMP_DIR=./tmp

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Android Firebase Cloud Messaging. Keep disabled locally unless a service-account
# JSON file is mounted outside source control.
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Transactional password-reset email. PASSWORD_RESET_URL may contain {token}.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_URL=basarat://reset-password?token={token}

GRU_MODEL_PATH=models/gru_v1

# Training / Retraining
TRAINING_LOOKBACK_YEARS=5
TRAINING_MIN_NEW_SAMPLES=100
MIN_ACCURACY_IMPROVEMENT=0.01
MIN_F1_IMPROVEMENT=0.01
MAX_ABSTENTION_INCREASE=0.05
LABEL_THRESHOLD=0.01
WINDOW_SIZE=30

# News ingestion — market-aware schedule (Asia/Karachi, UTC+5)
NEWS_TIMEZONE=Asia/Karachi
# PSX market session
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30
# Post-market ingestion window
POST_MARKET_CLOSE_HOUR=17
POST_MARKET_CLOSE_MINUTE=0
# Ingestion interval during active windows (seconds)
NEWS_INGESTION_INTERVAL_MARKET=1800      # 30 min during market
NEWS_INGESTION_INTERVAL_POST_MARKET=3600  # 60 min post-market
# Manual refresh cooldown (seconds)
NEWS_REFRESH_COOLDOWN=300  # 5 minutes

# HuggingFace (FinBERT sentiment via Inference API)
HF_API_TOKEN=

# ML
HF_API_TOKEN=
