PROJECT_NAME=Basarat
ENVIRONMENT=development
PYTHON_VERSION=3.11.9
DEBUG=false

# Generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON arrays; set explicit production origins (e.g. ["*"] or ["https://yourdomain.com"])
CORS_ORIGINS=["*"]
TRUSTED_PROXY_IPS=[]

# Database:
# Local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/basarat
# Supabase: use its shared Session pooler (IPv4) URL, or Transaction
# pooler when needed; port 6543 is handled with asyncpg statement caching off.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/basarat
# Optional. If omitted, derived from DATABASE_URL for Alembic and sync tasks.
DATABASE_URL_SYNC=

# Redis & Cache:
# Local Docker: redis://localhost:6379/0
# Production Compose passes these through: whatever REDIS_URL is set here is the
# one every service (including `migrate`) uses. The bundled `redis` service is
# only a fallback used when REDIS_URL is unset, so pointing this at an external
# managed instance (ElastiCache / Upstash) works without editing Compose.
# Upstash: rediss://default:<url-encoded-password>@<endpoint>.upstash.io:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
CACHE_TTL_SECONDS=300
# Memory ceiling for the bundled Redis service. Keeps a large board snapshot
# from OOM-killing the container.
REDIS_MAXMEMORY=512mb

# File Uploads & Local Temp Directory
MAX_FILE_SIZE_MB=10
LOCAL_TEMP_DIR=./tmp

# Celery & Task Runner:
# Local Docker: USE_CELERY=true
# Cloud in-process mode: USE_CELERY=false
# Production Compose routes Celery broker/results to private Redis databases /1 and /2.
# For standalone Upstash Celery URLs, append ?ssl_cert_reqs=required.
USE_CELERY=true
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq (LLM Assistant) — free-tier; confirm ids via GET /openai/v1/models
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Neon S3 Storage & AI Gateway
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
NEON_AI_GATEWAY_TOKEN=

# Google & Apple OAuth Configuration
# Google: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Clerk: Dashboard -> Configure -> Developers -> API keys / Webhooks
# CLERK_SECRET_KEY is the Clerk backend API secret; CLERK_WEBHOOK_SECRET is the
# signing secret for the configured Clerk webhook endpoint.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Apple Sign In: APPLE_CLIENT_ID must match the token audience (Service ID or Bundle ID).
# Team/Key IDs are included for Apple Developer credential configuration; the
# current API verifies Apple identity tokens directly and only requires CLIENT_ID.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# HuggingFace (FinBERT sentiment via Inference API)
HF_API_TOKEN=

# Android Firebase Cloud Messaging (FCM)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Transactional password-reset email. PASSWORD_RESET_URL may contain {token}.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_URL=basarat://reset-password?token={token}

# ML Models
GRU_MODEL_PATH=models/gru_v1

# Training / Retraining
TRAINING_LOOKBACK_YEARS=5
TRAINING_MIN_NEW_SAMPLES=100
MIN_ACCURACY_IMPROVEMENT=0.01
MIN_F1_IMPROVEMENT=0.01
MAX_ABSTENTION_INCREASE=0.05
LABEL_THRESHOLD=0.01
WINDOW_SIZE=30

# News ingestion — market-aware schedule (Asia/Karachi, UTC+5)
NEWS_TIMEZONE=Asia/Karachi
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30
POST_MARKET_CLOSE_HOUR=17
POST_MARKET_CLOSE_MINUTE=0
# Live session quotes (shared scraper snapshot; API stays read-only)
MARKET_SESSION_REFRESH_ENABLED=true
# Scrape cadence during PSX open hours. PSX throttles/block aggressive scrapers,
# so keep this at 120s or above; 180s (3 min) is the recommended production value.
MARKET_SESSION_REFRESH_SECONDS=180
# Random jitter (seconds) added to each refresh so requests do not form a
# fixed-interval fingerprint that PSX can detect and block.
MARKET_SESSION_REFRESH_JITTER_SECONDS=30
# Redis TTL for the board snapshot. Keep comfortably above the scrape interval.
MARKET_QUOTES_TTL_SECONDS=300
MARKET_LIVE_PUBSUB_CHANNEL=market:quotes:live
# How long to stop scraping entirely after PSX returns 403/429.
MARKET_CIRCUIT_BREAKER_SECONDS=1800
# Stop scraping after this many consecutive failures until one succeeds.
MARKET_SCRAPE_FAILURE_THRESHOLD=3
MARKET_REST_POLL_SECONDS=15
# Historical OHLCV closes must NEVER be presented as live quotes. Leave false in
# production: the API then returns 503 when the live feed is unavailable instead
# of silently serving a previous day's close.
# Permit an explicitly stale, age-limited daily close fallback (never label it live).
MARKET_SERVE_STALE_REFERENCE_DATA=true
# Only used when the line above is true: reject reference data older than this.
MARKET_REFERENCE_MAX_AGE_DAYS=5
MARKET_REFERENCE_TTL_SECONDS=900
# Reject cached quotes older than this (seconds) with 503. 0 disables the guard.
# Must exceed MARKET_QUOTES_TTL_SECONDS to allow for one missed scrape.
MARKET_MAX_STALE_SECONDS=900
NEWS_INGESTION_INTERVAL_MARKET=1800      # 30 min during market
NEWS_INGESTION_INTERVAL_POST_MARKET=3600  # 60 min post-market
NEWS_REFRESH_COOLDOWN=300                # 5 minutes
