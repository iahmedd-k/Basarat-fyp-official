PROJECT_NAME=Basarat
ENVIRONMENT=development
PYTHON_VERSION=3.11.9
DEBUG=false

# Generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Development default allows all browser origins; use explicit origins in production.
CORS_ORIGINS=["*"]
TRUSTED_PROXY_IPS=[]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Database:
# Local Docker Compose credentials (set a random local-only password).
POSTGRES_USER=basarat
POSTGRES_PASSWORD=
POSTGRES_DB=basarat
# Local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/basarat
# Supabase: use its shared Session pooler (IPv4) URL, or Transaction
# pooler when needed; port 6543 is handled with asyncpg statement caching off.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/basarat
# Required by docker-compose.production.yml; set to the managed production DB URL.
CLOUD_DATABASE_URL=
# Optional. If omitted, derived from DATABASE_URL for Alembic and sync tasks.
DATABASE_URL_SYNC=

# Redis & Cache:
# Local Docker: redis://localhost:6379/0
# Upstash: rediss://default:<url-encoded-password>@<endpoint>.upstash.io:6379/0
REDIS_URL=redis://localhost:6379/0
# Optional production fallback; also supplies local Celery URLs when they are unset.
CLOUD_REDIS_URL=
REDIS_ENABLED=true
CACHE_TTL_SECONDS=300
# Optional Upstash REST integration settings.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# File Uploads & Local Temp Directory
MAX_FILE_SIZE_MB=10
LOCAL_TEMP_DIR=./tmp

# Celery & Task Runner:
# Local Docker: USE_CELERY=true
# Cloud in-process mode: USE_CELERY=false
# Upstash Celery URLs use the same /0 database and append ?ssl_cert_reqs=required.
USE_CELERY=true
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq (LLM Assistant) — free-tier; confirm ids via GET /openai/v1/models
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Neon S3 Storage & AI Gateway
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
NEON_AI_GATEWAY_TOKEN=

# Google & Apple OAuth Configuration
# Google: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple: Apple Developer Portal -> Certificates, Identifiers & Profiles -> Service IDs
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Clerk authentication and webhook integration
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# HuggingFace (FinBERT sentiment via Inference API)
HF_API_TOKEN=

# Android Firebase Cloud Messaging (FCM)
FIREBASE_ENABLED=false
# Oracle Compose mounts this host directory read-only at /run/secrets.
FIREBASE_CREDENTIALS_HOST_PATH=./secrets
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Transactional password-reset email. PASSWORD_RESET_URL may contain {token}.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_URL=basarat://reset-password?token={token}
FRONTEND_URL=

# SendGrid (optional transactional email provider)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ML Models
GRU_MODEL_PATH=models/gru_v1

# Training / Retraining
TRAINING_LOOKBACK_YEARS=5
TRAINING_MIN_NEW_SAMPLES=100
MIN_ACCURACY_IMPROVEMENT=0.01
MIN_F1_IMPROVEMENT=0.01
MAX_ABSTENTION_INCREASE=0.05
LABEL_THRESHOLD=0.01
WINDOW_SIZE=30

# News ingestion — market-aware schedule (Asia/Karachi, UTC+5)
NEWS_TIMEZONE=Asia/Karachi
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30
POST_MARKET_CLOSE_HOUR=17
POST_MARKET_CLOSE_MINUTE=0
# Live session quotes (shared scraper snapshot; API stays read-only)
MARKET_SESSION_REFRESH_ENABLED=true
MARKET_SESSION_REFRESH_SECONDS=60
MARKET_QUOTES_TTL_SECONDS=90
MARKET_LIVE_PUBSUB_CHANNEL=market:quotes:live
MARKET_CIRCUIT_BREAKER_SECONDS=900
MARKET_REST_POLL_SECONDS=15
NEWS_INGESTION_INTERVAL_MARKET=1800      # 30 min during market
NEWS_INGESTION_INTERVAL_POST_MARKET=3600  # 60 min post-market
NEWS_REFRESH_COOLDOWN=300                # 5 minutes
