PROJECT_NAME=Basarat
ENVIRONMENT=development
DEBUG=false

# Generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON arrays; set explicit production origins (e.g. ["*"] or ["https://yourdomain.com"])
CORS_ORIGINS=["*"]
TRUSTED_PROXY_IPS=[]

# Database:
# Local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/basarat
# Neon Cloud: postgresql+asyncpg://<user>:<password>@<neon-host>.neon.tech/neondb?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/basarat
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/basarat

# Redis & Cache:
# Local Docker: redis://localhost:6379/0
# Redis Cloud / Upstash: redis://default:<password>@<endpoint>:<port>/0
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
CACHE_TTL_SECONDS=300

# File Uploads & Local Temp Directory
MAX_FILE_SIZE_MB=10
LOCAL_TEMP_DIR=./tmp

# Celery & Task Runner:
# Local Docker: USE_CELERY=true
# Render / Cloud in-process mode (zero extra cost): USE_CELERY=false
USE_CELERY=true
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq (LLM Assistant)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Neon S3 Storage & AI Gateway
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
NEON_AI_GATEWAY_TOKEN=

# HuggingFace (FinBERT sentiment via Inference API)
HF_API_TOKEN=

# Android Firebase Cloud Messaging (FCM)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Transactional password-reset email. PASSWORD_RESET_URL may contain {token}.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_URL=basarat://reset-password?token={token}

# ML Models
GRU_MODEL_PATH=models/gru_v1

# Training / Retraining
TRAINING_LOOKBACK_YEARS=5
TRAINING_MIN_NEW_SAMPLES=100
MIN_ACCURACY_IMPROVEMENT=0.01
MIN_F1_IMPROVEMENT=0.01
MAX_ABSTENTION_INCREASE=0.05
LABEL_THRESHOLD=0.01
WINDOW_SIZE=30

# News ingestion — market-aware schedule (Asia/Karachi, UTC+5)
NEWS_TIMEZONE=Asia/Karachi
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30
POST_MARKET_CLOSE_HOUR=17
POST_MARKET_CLOSE_MINUTE=0
NEWS_INGESTION_INTERVAL_MARKET=1800      # 30 min during market
NEWS_INGESTION_INTERVAL_POST_MARKET=3600  # 60 min post-market
NEWS_REFRESH_COOLDOWN=300                # 5 minutes
