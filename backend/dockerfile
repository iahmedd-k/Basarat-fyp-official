FROM python:3.11.9-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 app \
    && useradd --uid 1000 --gid 1000 --create-home --home-dir /home/app --shell /usr/sbin/nologin app

COPY requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --default-timeout=300 --retries=10 -r /tmp/requirements.txt \
    && python -m pip install --no-cache-dir --default-timeout=300 --retries=10 --no-deps "xgboost>=2.0,<4" \
    && rm /tmp/requirements.txt

COPY --chown=1000:1000 app/ ./app/
COPY --chown=1000:1000 alembic/ ./alembic/
COPY --chown=1000:1000 alembic.ini ./alembic.ini
COPY --chown=1000:1000 data/config/ ./data/config/
COPY --chown=1000:1000 models/production/v3/gru_best_weights.weights.h5 ./models/production/v3/gru_best_weights.weights.h5
COPY --chown=1000:1000 models/production/v3/gru_features.json ./models/production/v3/gru_features.json
COPY --chown=1000:1000 models/production/v3/gru_scaler.joblib ./models/production/v3/gru_scaler.joblib
COPY --chown=1000:1000 models/production/v3/xgb_model.ubj ./models/production/v3/xgb_model.ubj
COPY --chown=1000:1000 models/production/v3/xgb_features.json ./models/production/v3/xgb_features.json
COPY --chown=1000:1000 deploy_assets/ ./deploy_assets/
COPY --chown=1000:1000 scripts/ ./scripts/

RUN mkdir -p /app/tmp /app/data/raw/ohlcv /app/data/features /app/data/reports /app/data/reports/sentiment /app/data/reports/monte_carlo /app/data/news_state /var/lib/celery /home/app \
    && chown -R 1000:1000 /app /var/lib/celery /home/app \
    && chmod -R 777 /app/tmp /app/data /var/lib/celery /home/app

USER 1000:1000

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=120s --retries=3 \
    CMD ["python", "-c", "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/health', timeout=2)"]

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
